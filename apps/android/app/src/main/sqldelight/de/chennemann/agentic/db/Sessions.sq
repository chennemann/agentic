selectSessions:
SELECT id, project_id, title, path, pinned, parent_id, updated_at, archived_at
FROM sessions
ORDER BY pinned DESC, updated_at DESC, title COLLATE NOCASE ASC, id ASC;

selectSessionById:
SELECT id, project_id, title, path, pinned, parent_id, updated_at, archived_at
FROM sessions
WHERE id = ?;

selectSessionsByProject:
SELECT id, project_id, title, path, pinned, parent_id, updated_at, archived_at
FROM sessions
WHERE project_id = ?
ORDER BY pinned DESC, updated_at DESC, title COLLATE NOCASE ASC, id ASC;

insertSession:
INSERT INTO sessions(
  id,
  project_id,
  title,
  path,
  pinned,
  parent_id,
  updated_at,
  archived_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateSession:
UPDATE sessions
SET project_id = ?,
    title = ?,
    path = ?,
    pinned = ?,
    parent_id = ?,
    updated_at = ?,
    archived_at = ?
WHERE id = ?;

deleteSession:
DELETE FROM sessions
WHERE id = ?;
