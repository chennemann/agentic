CREATE TABLE environment_entity (
    environment_id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    base_url TEXT NOT NULL,
    platform_os TEXT NOT NULL,
    platform_arch TEXT NOT NULL,
    server_version TEXT NOT NULL,
    active INTEGER NOT NULL DEFAULT 0,
    last_connected_at INTEGER
);

CREATE TABLE projection_cache (
    environment_id TEXT NOT NULL,
    cache_kind TEXT NOT NULL,
    cache_key TEXT NOT NULL,
    schema_version INTEGER NOT NULL,
    sequence INTEGER,
    payload_json TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (environment_id, cache_kind, cache_key)
);

CREATE TABLE local_preference (
    environment_id TEXT NOT NULL,
    preference_key TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    PRIMARY KEY (environment_id, preference_key)
);

CREATE TABLE command_outbox (
    outbox_sequence INTEGER PRIMARY KEY AUTOINCREMENT,
    environment_id TEXT NOT NULL,
    command_id TEXT NOT NULL,
    command_json TEXT NOT NULL,
    status TEXT NOT NULL,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    created_at INTEGER NOT NULL,
    UNIQUE (environment_id, command_id)
);

CREATE TABLE shared_text_import (
    fingerprint TEXT NOT NULL PRIMARY KEY,
    content TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

selectAllEnvironments:
SELECT * FROM environment_entity ORDER BY label COLLATE NOCASE, environment_id;

selectActiveEnvironment:
SELECT * FROM environment_entity WHERE active = 1 LIMIT 1;

upsertEnvironment:
INSERT OR REPLACE INTO environment_entity(
    environment_id,
    label,
    base_url,
    platform_os,
    platform_arch,
    server_version,
    active,
    last_connected_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

clearActiveEnvironment:
UPDATE environment_entity SET active = 0;

setActiveEnvironment:
UPDATE environment_entity SET active = 1 WHERE environment_id = ?;

deleteEnvironment:
DELETE FROM environment_entity WHERE environment_id = ?;

selectProjection:
SELECT sequence, payload_json FROM projection_cache
WHERE environment_id = ? AND cache_kind = ? AND cache_key = ?
LIMIT 1;

selectProjectionPayloadByteCount:
SELECT length(CAST(payload_json AS BLOB)) FROM projection_cache
WHERE environment_id = ? AND cache_kind = ? AND cache_key = ?
LIMIT 1;

selectEnvironmentProjectionUsage:
SELECT cache_kind, count(*) AS entry_count, coalesce(sum(length(CAST(payload_json AS BLOB))), 0) AS byte_count
FROM projection_cache WHERE environment_id = ? GROUP BY cache_kind;

selectEnvironmentPreferenceUsage:
SELECT count(*) AS entry_count, coalesce(sum(length(CAST(payload_json AS BLOB))), 0) AS byte_count
FROM local_preference WHERE environment_id = ? AND preference_key NOT LIKE 'composer-draft-v1:%';

selectEnvironmentDraftUsage:
SELECT count(*) AS entry_count, coalesce(sum(length(CAST(payload_json AS BLOB))), 0) AS byte_count
FROM local_preference WHERE environment_id = ? AND preference_key LIKE 'composer-draft-v1:%';

selectEnvironmentOutboxCount:
SELECT count(*) FROM command_outbox WHERE environment_id = ?;

upsertProjection:
INSERT OR REPLACE INTO projection_cache(
    environment_id,
    cache_kind,
    cache_key,
    schema_version,
    sequence,
    payload_json,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteEnvironmentProjections:
DELETE FROM projection_cache WHERE environment_id = ?;

deleteProjection:
DELETE FROM projection_cache
WHERE environment_id = ? AND cache_kind = ? AND cache_key = ?;

selectPreference:
SELECT payload_json FROM local_preference
WHERE environment_id = ? AND preference_key = ?
LIMIT 1;

upsertPreference:
INSERT OR REPLACE INTO local_preference(environment_id, preference_key, payload_json)
VALUES (?, ?, ?);

deletePreference:
DELETE FROM local_preference
WHERE environment_id = ? AND preference_key = ?;

deleteEnvironmentPreferences:
DELETE FROM local_preference WHERE environment_id = ?;

deleteEnvironmentClearablePreferences:
DELETE FROM local_preference
WHERE environment_id = ? AND preference_key NOT LIKE 'composer-draft-v1:%';

selectOutbox:
SELECT * FROM command_outbox
WHERE environment_id = ?
ORDER BY outbox_sequence;

enqueueCommand:
INSERT OR IGNORE INTO command_outbox(
    environment_id, command_id, command_json, status, attempt_count, last_error, created_at
) VALUES (?, ?, ?, 'pending', 0, NULL, ?);

markCommandPending:
UPDATE command_outbox
SET status = 'pending', attempt_count = attempt_count + 1, last_error = NULL
WHERE environment_id = ? AND command_id = ?;

markCommandFailed:
UPDATE command_outbox SET status = 'failed', last_error = ?
WHERE environment_id = ? AND command_id = ?;

deleteCommand:
DELETE FROM command_outbox WHERE environment_id = ? AND command_id = ?;

deleteEnvironmentCommands:
DELETE FROM command_outbox WHERE environment_id = ?;

selectPendingSharedText:
SELECT fingerprint, content FROM shared_text_import
WHERE status = 'pending' ORDER BY created_at LIMIT 1;

insertSharedTextReceipt:
INSERT OR IGNORE INTO shared_text_import(fingerprint, content, status, created_at)
VALUES (?, ?, 'pending', ?);

setSharedTextReceiptStatus:
UPDATE shared_text_import SET status = ? WHERE fingerprint = ?;
